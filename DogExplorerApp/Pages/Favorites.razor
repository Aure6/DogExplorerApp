@page "/favorites"
@inject LocalAppState AppState
@implements IDisposable

<PageTitle>Mes Favoris</PageTitle>

@if (!AppState.CurrentUser.IsAuthenticated)
{
    <p>Veuillez vous connecter sur la page d'accueil pour voir vos favoris.</p>
}
else
{
    <h2>Mes Chiens Favoris (@AppState.Favorites.Count)</h2>

    <div class="row">
        @foreach (var dog in AppState.Favorites)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@dog.ImageUrl" class="card-img-top" alt="Dog" style="height: 200px; object-fit: cover;" />
                    <div class="card-body">
                        @if (editingId == dog.Id)
                        {
                            <input @bind="editName" class="form-control mb-2" />
                            <textarea @bind="editDescription" class="form-control mb-2"></textarea>
                            <button class="btn btn-success btn-sm" @onclick="() => SaveEdit(dog)">Sauvegarder</button>
                            <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Annuler</button>
                        }
                        else
                        {
                            <h5 class="card-title">@dog.CustomName</h5>
                            <p class="card-text">@dog.Description</p>
                            <button class="btn btn-warning btn-sm" @onclick="() => StartEdit(dog)">Modifier</button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => AppState.RemoveFavoriteAsync(dog.Id)">Supprimer</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private Guid? editingId;
    private string? editName; // <-- Ajoutez le ? ici
    private string? editDescription; // <-- Et le ? ici

    protected override void OnInitialized() => AppState.OnChange += StateHasChanged;

    private void StartEdit(FavoriteDog dog)
    {
        editingId = dog.Id;
        editName = dog.CustomName;
        editDescription = dog.Description;
    }

    private async Task SaveEdit(FavoriteDog dog)
    {
        dog.CustomName = editName;
        dog.Description = editDescription;
        await AppState.UpdateFavoriteAsync(dog); // On attend la sauvegarde
        editingId = null;
    }

    private void CancelEdit() => editingId = null;

    public void Dispose() => AppState.OnChange -= StateHasChanged;
}