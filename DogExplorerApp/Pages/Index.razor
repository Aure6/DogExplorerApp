@page "/"
@inject DogApiService DogApi
@inject LocalAppState AppState
@implements IDisposable

<PageTitle>Dog Explorer</PageTitle>

@if (!AppState.CurrentUser.IsAuthenticated)
{
    <div class="card p-4 mx-auto shadow-sm" style="max-width: 400px; background-color: #F9F6F0">
        <h3 class=" text-center mb-4">@(isRegistering ? "Créer un compte" : "Connexion")</h3>

        @if (!string.IsNullOrEmpty(AppState.ErrorMessage))
        {
            <div class="alert alert-danger py-2">@AppState.ErrorMessage</div>
        }

        <input @bind="username" class="form-control mb-3" placeholder="Nom d'utilisateur" />
        <input @bind="password" type="password" class="form-control mb-3" placeholder="Mot de passe" />

        @if (isRegistering)
        {
            <button class="btn btn-success w-100 mb-2" @onclick="Register">S'inscrire</button>
            <button class="btn btn-link w-100 text-decoration-none"
                    @onclick="() => { isRegistering = false; AppState.LoginAsync(null, null); }">
                Déjà un compte ? Se connecter
            </button>
        }
        else
        {
            <button class="btn btn-primary w-100 mb-2" @onclick="Login">Se connecter</button>
            <button class="btn btn-link w-100 text-decoration-none"
                    @onclick="() => { isRegistering = true; AppState.LoginAsync(null, null); }">
                Nouveau ? Créer un compte
            </button>
        }
    </div>
}
else
{
    <div class="text-center">
        <h2>Bienvenue, @AppState.CurrentUser.Username !</h2>

        @if (currentDogUrl != null)
        {
            <h4 class="text-primary mb-3">
                <i class="bi bi-info-circle"></i> Race : @DogApiService.GetBreedFromUrl(currentDogUrl)
            </h4>
            <div>
                <img src="@currentDogUrl" alt="Un chien mignon" class="img-fluid rounded shadow-sm mb-3"
                     style="max-height: 400px;" />
            </div>
            <button class="btn btn-success me-2" @onclick="() => AppState.AddFavoriteAsync(currentDogUrl)"><i
                class="bi bi-heart-fill"></i> Ajouter aux
                Favoris</button>
                <button class="btn btn-success" @onclick="LoadNewDog">Passer au suivant <i class="bi bi-arrow-right"></i></button>
            }
        else
            {
                <p>Chargement du toutou...</p>
            }
        </div>
    }

@code {
    private bool isRegistering = false; // Permet de basculer entre les deux modes
    private string? username;
    private string? password;
    private string? currentDogUrl;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        if (AppState.CurrentUser.IsAuthenticated) await LoadNewDog();
    }

    private async Task Login()
    {
        await AppState.LoginAsync(username, password);
        if (AppState.CurrentUser.IsAuthenticated)
        {
            await LoadNewDog();
        }
    }

    private async Task Register()
    {
        await AppState.RegisterAsync(username, password);
        if (AppState.CurrentUser.IsAuthenticated) await LoadNewDog();
    }

    private async Task LoadNewDog()
    {
        // On vide l'URL précédente (si on clique sur "Suivant")
        currentDogUrl = null;

        try
        {
            // On va chercher l'image sur Internet
            currentDogUrl = await DogApi.GetRandomDogAsync();
        }
        catch (Exception ex)
        {
            // Au cas où il n'y a pas d'internet
            Console.WriteLine($"Erreur API : {ex.Message}");
        }

        StateHasChanged();
    }

    public void Dispose() => AppState.OnChange -= StateHasChanged;
}